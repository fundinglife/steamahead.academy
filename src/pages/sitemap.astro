---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const entries = [
  ...(await getCollection("pages")),
  ...(await getCollection("subjects")),
  ...(await getCollection("grades"))
].sort((a, b) => a.data.navGroup.localeCompare(b.data.navGroup) || a.data.order - b.data.order);
---

<BaseLayout title="Sitemap | SteamAhead Academy" description="Generated page map for Markdown-backed public routes.">
  <section class="bg-ocean-50 py-12">
    <div class="page-shell">
      <p class="text-sm font-black uppercase tracking-widest text-leaf-700">Generated from Markdown</p>
      <h1 class="mt-3 text-5xl font-black text-ocean-700">Sitemap</h1>
    </div>
  </section>
  <section class="py-12">
    <div class="page-shell grid gap-3">
      {entries.map((entry) => (
        <a class="content-card flex items-center justify-between gap-4 max-sm:block" href={`/${entry.slug}`}>
          <span>
            <strong class="block text-ocean-700">{entry.data.title}</strong>
            <small class="text-slate-500">Reference title: {entry.data.ixlReferenceTitle ?? entry.data.title}</small>
          </span>
          <span class="text-sm font-black text-leaf-700">/{entry.slug}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
