---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const lessons = await getCollection("lessons");
  return lessons.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} | Lessons | SteamAhead Academy`} description={entry.data.objective}>
  <section class="bg-ocean-50 py-12">
    <div class="page-shell">
      <p class="text-sm font-black uppercase tracking-widest text-leaf-700">{entry.data.format} · {entry.data.estimatedMinutes} min</p>
      <h1 class="mt-3 max-w-4xl text-5xl font-black leading-none text-ocean-700 max-md:text-4xl">{entry.data.title}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">{entry.data.objective}</p>
    </div>
  </section>
  <section class="py-12">
    <div class="page-shell grid grid-cols-[1fr_320px] gap-8 max-lg:grid-cols-1">
      <article class="prose prose-slate max-w-none prose-headings:text-ocean-700">
        <Content />
      </article>
      <aside class="content-card">
        <h2 class="text-lg font-black text-ocean-700">Checks</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-slate-600">
          {entry.data.checks.map((check) => <li>{check}</li>)}
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>
