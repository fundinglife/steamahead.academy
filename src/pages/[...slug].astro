---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import MarkdownCard from "@/components/MarkdownCard.astro";
import { mathPathways } from "@/data/mathPathways";
import generatedIxl from "@/data/generated/ixlPublicPages.json";

interface SourceLink {
  label: string;
  path: string;
}

interface SourceSection {
  code: string;
  title: string;
  skills: SourceLink[];
}

interface LandingGroup {
  path: string;
  title: string;
  badge: string;
  skillCount?: string;
  samples: SourceLink[];
}

interface ContentLink {
  label: string;
  href: string;
  description?: string;
}

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  const subjects = await getCollection("subjects");
  const grades = await getCollection("grades");
  const contentEntries = [...pages, ...subjects, ...grades];
  const paths = new Map();
  for (const entry of contentEntries) {
    paths.set(entry.slug, {
      params: { slug: entry.slug },
      props: { entry, sourcePage: generatedIxl.pages.find((page) => page.path.replace(/^\//, "") === entry.slug) }
    });
  }
  for (const sourcePage of generatedIxl.pages) {
    const slug = sourcePage.path.replace(/^\//, "");
    if (!slug || paths.has(slug)) continue;
    paths.set(slug, {
      params: { slug },
      props: { sourcePage }
    });
  }
  return [...paths.values()];
}

const { entry, sourcePage } = Astro.props;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const concepts = await getCollection("concepts");
const lessons = await getCollection("lessons");
const title = sourcePage?.title ?? entry?.data.title;
const description = entry?.data.description ?? `Generated equivalent route for ${sourcePage.sourceUrl}. This page preserves the public route, title, link structure, and source-page references while original equivalent content is authored.`;
const navGroup = entry?.data.navGroup ?? sourcePage.navGroup;
const referenceTitle = sourcePage?.title ?? entry?.data.ixlReferenceTitle;
const allSourceLinks = ((sourcePage?.links ?? []) as SourceLink[]).filter((link: SourceLink, index: number, links: SourceLink[]) => links.findIndex((candidate: SourceLink) => candidate.path === link.path && candidate.label === link.label) === index);
const skillSections = ((sourcePage?.skillSections ?? []) as SourceSection[]).filter((section: SourceSection) => section.skills.length > 0);
const totalSourceSkills = skillSections.reduce((count: number, section: SourceSection) => count + section.skills.length, 0);
const sourcePath = sourcePage?.path ?? `/${entry?.slug}`;
const sourceLinks = allSourceLinks.filter((link: SourceLink) => link.path !== sourcePath && link.path.startsWith(`${sourcePath}/`)).slice(0, 24);
const relatedConcepts = entry ? concepts.filter((concept) => concept.data.subject.toLowerCase() === title.toLowerCase() || concept.data.gradeBand.toLowerCase() === title.toLowerCase()).slice(0, 6) : [];
const relatedLessons = entry ? lessons.filter((lesson) => lesson.data.subject.toLowerCase() === title.toLowerCase() || lesson.data.gradeBand.toLowerCase() === title.toLowerCase()).slice(0, 6) : [];
const isMathIndex = (entry?.collection === "subjects" && entry.slug === "math") || sourcePage?.path === "/math";
const childPathPattern = new RegExp(`^${sourcePath.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}/[^/]+$`);
const isSubjectIndex = ["/ela", "/science", "/social-studies"].includes(sourcePath);

function isUsefulTitle(label: string) {
  return label.length > 1 && !label.startsWith("See all") && !["Videos", "Games", "Skills"].includes(label);
}

function buildLandingGroups(links: SourceLink[]) {
  const groups = new Map<string, LandingGroup>();
  let current: LandingGroup | undefined;

  for (const link of links) {
    if (!link.path.startsWith(`${sourcePath}/`)) continue;

    if (childPathPattern.test(link.path)) {
      const existing = groups.get(link.path);
      if (!existing) {
        current = {
          path: link.path,
          title: isUsefulTitle(link.label) ? link.label : link.path.split("/").at(-1)?.replaceAll("-", " ") ?? link.label,
          badge: link.label.slice(0, 2).toUpperCase(),
          samples: []
        };
        groups.set(link.path, current);
      } else {
        current = existing;
        if (isUsefulTitle(link.label)) current.title = link.label;
      }
      continue;
    }

    if (!current || !link.path.startsWith(`${current.path}/`)) continue;
    if (current.samples.some((sample) => sample.path === link.path)) continue;
    current.samples.push(link);
  }

  for (const group of groups.values()) {
    const countLink = links.find((link) => link.path === group.path && link.label.startsWith("See all"));
    group.skillCount = countLink?.label;
    group.samples = group.samples.slice(0, 6);
  }

  return [...groups.values()].filter((group) => group.samples.length || group.skillCount);
}

const landingGroups = isSubjectIndex ? buildLandingGroups(allSourceLinks) : [];
const sidebarLinks = landingGroups.length
  ? landingGroups.map((group) => ({ label: group.title, path: group.path }))
  : sourceLinks;
---

<BaseLayout title={`${title} | SteamAhead Academy`} description={description}>
  <section class="bg-ocean-50 py-12">
    <div class="page-shell">
      <p class="text-sm font-black uppercase tracking-widest text-leaf-700">{navGroup}</p>
      <h1 class="mt-3 max-w-4xl text-5xl font-black leading-none text-ocean-700 max-md:text-4xl">{title}</h1>
      {referenceTitle && <p class="mt-3 text-sm font-bold text-slate-500">Reference title: {referenceTitle}</p>}
      {sourcePage?.sourceUrl && <p class="mt-1 text-sm font-bold text-slate-500">Source route: {sourcePage.path}</p>}
      {totalSourceSkills > 0 && <p class="mt-3 text-lg font-black text-leaf-700">{skillSections.length} concept groups · {totalSourceSkills} linked skills</p>}
      {landingGroups.length > 0 && <p class="mt-3 text-lg font-black text-leaf-700">{landingGroups.length} grade and course pathways</p>}
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">{description}</p>
      {entry?.data.cta && <a class="button-primary mt-7" href="/membership">{entry.data.cta}</a>}
    </div>
  </section>
  {landingGroups.length > 0 && (
    <section class="bg-white py-12">
      <div class="page-shell grid grid-cols-[minmax(0,1fr)_280px] items-start gap-8 max-lg:grid-cols-1">
        <div>
          <div class="mb-7">
            <h2 class="text-3xl font-black text-ocean-700">Skills by grade and course</h2>
            <p class="mt-2 max-w-3xl text-slate-600">
              These pathways are generated from the discovered source-page links. Each grade/course and sampled skill links to a local equivalent route.
            </p>
          </div>
          <div class="grid grid-cols-3 gap-4 max-xl:grid-cols-2 max-sm:grid-cols-1">
            {landingGroups.map((group: LandingGroup) => (
              <section class="content-card border-t-4 border-t-ocean-500">
                <a class="flex items-start gap-3" href={group.path}>
                  <span class="grid min-h-10 min-w-10 place-items-center rounded-md bg-ocean-500 px-2 text-sm font-black text-white">{group.badge}</span>
                  <span>
                    <h3 class="text-xl font-black text-ocean-700">{group.title}</h3>
                    {group.skillCount && <span class="mt-1 block text-sm font-bold text-leaf-700">{group.skillCount}</span>}
                  </span>
                </a>
                <ul class="mt-4 grid gap-2">
                  {group.samples.map((sample: SourceLink) => (
                    <li>
                      <a class="block rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-bold text-ocean-700 hover:border-ocean-500 hover:bg-white" href={sample.path}>{sample.label}</a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
        <aside class="sticky top-40 rounded-lg border border-slate-200 bg-white p-4 shadow-sm max-lg:static">
          <h2 class="text-sm font-black uppercase tracking-widest text-leaf-700">Page links</h2>
          <nav class="mt-3 grid gap-1 text-sm font-bold">
            {sidebarLinks.map((link: SourceLink) => <a class="rounded-md px-3 py-2 text-ocean-700 hover:bg-ocean-50" href={link.path}>{link.label}</a>)}
          </nav>
        </aside>
      </div>
    </section>
  )}
  {landingGroups.length === 0 && <section class="py-12">
    <div class="page-shell grid grid-cols-[minmax(0,1fr)_280px] items-start gap-8 max-lg:grid-cols-1">
      <article class="prose prose-slate max-w-none prose-headings:text-ocean-700 prose-a:text-ocean-700">
        {Content && !landingGroups.length ? <Content /> : landingGroups.length ? (
          <>
            <h2>Source route structure</h2>
            <p>This subject index is generated from the discovered grade/course links and sampled skill links for the source route. Use the pathway cards above or the sidebar to move into each local equivalent page.</p>
          </>
        ) : (
          <>
            <h2>Equivalent page scaffold</h2>
            <p>This route was discovered from the public site and is generated into the Astro app. It preserves the route, source title, page group, and discovered internal links. Original equivalent body content can be expanded in Markdown or generated data without changing route code.</p>
            <h2>Page role</h2>
            <p>This page belongs to the {navGroup} group and participates in the same public navigation graph as the source route.</p>
          </>
        )}
      </article>
      <aside class="sticky top-40 rounded-lg border border-slate-200 bg-white p-4 shadow-sm max-lg:static">
        <h2 class="text-sm font-black uppercase tracking-widest text-leaf-700">Page links</h2>
        <nav class="mt-3 grid gap-1 text-sm font-bold">
          {entry?.data.links.map((link: ContentLink) => <a class="rounded-md px-3 py-2 text-ocean-700 hover:bg-ocean-50" href={link.href}>{link.label}</a>)}
          {sidebarLinks.map((link: SourceLink) => <a class="rounded-md px-3 py-2 text-ocean-700 hover:bg-ocean-50" href={link.path}>{link.label}</a>)}
          {sidebarLinks.length === 0 && <p class="px-3 py-2 text-sm text-slate-500">No child links discovered for this route.</p>}
        </nav>
      </aside>
    </div>
  </section>}
  {skillSections.length > 0 && (
    <section class="bg-white py-12">
      <div class="page-shell">
        <div class="mb-7">
          <h2 class="text-3xl font-black text-ocean-700">Concept and skill breakdown</h2>
          <p class="mt-2 max-w-3xl text-slate-600">
            This section is generated from the discovered public page structure. Each source skill link has a local equivalent route.
          </p>
        </div>
        <div class="grid gap-5">
          {skillSections.map((section: SourceSection) => (
            <section class="content-card">
              <div class="mb-4 flex items-baseline gap-3">
                <span class="text-sm font-black text-leaf-700">{section.code}</span>
                <h3 class="text-2xl font-black text-ocean-700">{section.title}</h3>
                <span class="rounded-full bg-ocean-50 px-3 py-1 text-xs font-black text-ocean-700">{section.skills.length} skills</span>
              </div>
              <ol class="grid grid-cols-2 gap-2 max-md:grid-cols-1">
                {section.skills.map((skill: SourceLink, index: number) => (
                  <li>
                    <a class="flex gap-3 rounded-md border border-slate-200 bg-slate-50 p-3 text-sm font-bold text-ocean-700 hover:border-ocean-500 hover:bg-white" href={skill.path}>
                      <span class="text-slate-400">{index + 1}.</span>
                      <span>{skill.label}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </div>
    </section>
  )}
  {isMathIndex && (
    <section class="bg-slate-50 py-12">
      <div class="page-shell">
        <div class="mb-7">
          <h2 class="text-3xl font-black text-ocean-700">Math by grade and course</h2>
          <p class="mt-2 max-w-3xl text-slate-600">
            This mirrors the public Math index structure at the grade/course level, including the public skill counts. Topic labels are original equivalents used for navigation scaffolding.
          </p>
        </div>
        <div class="grid grid-cols-3 gap-4 max-lg:grid-cols-2 max-sm:grid-cols-1">
          {mathPathways.map((pathway) => (
            <a href={`/math/${pathway.slug}`} class="content-card block border-t-4 border-t-ocean-500">
              <div class="flex items-start gap-3">
                <span class="grid min-h-10 min-w-10 place-items-center rounded-md bg-ocean-500 px-2 text-sm font-black text-white">{pathway.badge}</span>
                <div>
                  <h3 class="text-xl font-black text-ocean-700">{pathway.title}</h3>
                  <p class="mt-1 text-sm font-bold text-leaf-700">See all {pathway.sourceSkillCount} skills</p>
                </div>
              </div>
              <p class="mt-4 text-sm leading-6 text-slate-600">
                Includes: {pathway.equivalentSampleTopics.join(" · ")}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  {(relatedConcepts.length > 0 || relatedLessons.length > 0) && (
    <section class="bg-slate-50 py-12">
      <div class="page-shell">
        {relatedConcepts.length > 0 && <h2 class="mb-5 text-2xl font-black text-ocean-700">Related concepts</h2>}
        <div class="mb-10 grid grid-cols-3 gap-4 max-lg:grid-cols-2 max-sm:grid-cols-1">
          {relatedConcepts.map((concept) => <MarkdownCard href={`/concepts/${concept.slug}`} title={concept.data.title} description={concept.data.summary} label={concept.data.domain} />)}
        </div>
        {relatedLessons.length > 0 && <h2 class="mb-5 text-2xl font-black text-ocean-700">Related lessons</h2>}
        <div class="grid grid-cols-3 gap-4 max-lg:grid-cols-2 max-sm:grid-cols-1">
          {relatedLessons.map((lesson) => <MarkdownCard href={`/lessons/${lesson.slug}`} title={lesson.data.title} description={lesson.data.objective} label={lesson.data.format} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
