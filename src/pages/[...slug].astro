---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import MarkdownCard from "@/components/MarkdownCard.astro";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  const subjects = await getCollection("subjects");
  const grades = await getCollection("grades");
  return [...pages, ...subjects, ...grades].map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const concepts = await getCollection("concepts");
const lessons = await getCollection("lessons");
const relatedConcepts = concepts.filter((concept) => concept.data.subject.toLowerCase() === entry.data.title.toLowerCase() || concept.data.gradeBand.toLowerCase() === entry.data.title.toLowerCase()).slice(0, 6);
const relatedLessons = lessons.filter((lesson) => lesson.data.subject.toLowerCase() === entry.data.title.toLowerCase() || lesson.data.gradeBand.toLowerCase() === entry.data.title.toLowerCase()).slice(0, 6);
---

<BaseLayout title={`${entry.data.title} | SteamAhead Academy`} description={entry.data.description}>
  <section class="bg-ocean-50 py-12">
    <div class="page-shell">
      <p class="text-sm font-black uppercase tracking-widest text-leaf-700">{entry.data.navGroup}</p>
      <h1 class="mt-3 max-w-4xl text-5xl font-black leading-none text-ocean-700 max-md:text-4xl">{entry.data.title}</h1>
      {entry.data.ixlReferenceTitle && <p class="mt-3 text-sm font-bold text-slate-500">Reference title: {entry.data.ixlReferenceTitle}</p>}
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">{entry.data.description}</p>
      {entry.data.cta && <a class="button-primary mt-7" href="/membership">{entry.data.cta}</a>}
    </div>
  </section>
  <section class="py-12">
    <div class="page-shell grid grid-cols-[1fr_320px] gap-8 max-lg:grid-cols-1">
      <article class="prose prose-slate max-w-none prose-headings:text-ocean-700 prose-a:text-ocean-700">
        <Content />
      </article>
      <aside class="space-y-4">
        {entry.data.links.map((link) => <MarkdownCard href={link.href} title={link.label} description={link.description} label="Linked page" />)}
      </aside>
    </div>
  </section>
  {(relatedConcepts.length > 0 || relatedLessons.length > 0) && (
    <section class="bg-slate-50 py-12">
      <div class="page-shell">
        {relatedConcepts.length > 0 && <h2 class="mb-5 text-2xl font-black text-ocean-700">Related concepts</h2>}
        <div class="mb-10 grid grid-cols-3 gap-4 max-lg:grid-cols-2 max-sm:grid-cols-1">
          {relatedConcepts.map((concept) => <MarkdownCard href={`/concepts/${concept.slug}`} title={concept.data.title} description={concept.data.summary} label={concept.data.domain} />)}
        </div>
        {relatedLessons.length > 0 && <h2 class="mb-5 text-2xl font-black text-ocean-700">Related lessons</h2>}
        <div class="grid grid-cols-3 gap-4 max-lg:grid-cols-2 max-sm:grid-cols-1">
          {relatedLessons.map((lesson) => <MarkdownCard href={`/lessons/${lesson.slug}`} title={lesson.data.title} description={lesson.data.objective} label={lesson.data.format} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
